# =============================================================================
# Affy's — environment variables
#
# Copy this file to `.env.local` and fill in the real values.
# Never commit `.env.local` — it's in .gitignore.
#
# For Vercel deployment, add each variable in:
#   Project Settings → Environment Variables
# (Mark NEXT_PUBLIC_* as "Available in both server and browser", everything
#  else as "Server only".)
# =============================================================================

# ─── Supabase ────────────────────────────────────────────────────────────────
# Get these from: Supabase Studio → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Server-only — DO NOT EXPOSE.
# This bypasses Row Level Security and is used by webhooks and admin tasks.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here


# ─── Stripe (Phase 2 — add when you connect payments) ────────────────────────
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...


# ─── Email (Phase 2 — Resend or Postmark) ────────────────────────────────────
# RESEND_API_KEY=re_...
# FROM_EMAIL=hello@atasteofaffy.com


# ─── WhatsApp (Phase 2 — Twilio or Meta Business) ────────────────────────────
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886


# ─── App config ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://atasteofaffy.com
NEXT_PUBLIC_WHATSAPP_DISPLAY=+351 914 145 519
NEXT_PUBLIC_WHATSAPP_HREF=https://wa.me/351914145519
NEXT_PUBLIC_SUPPORT_EMAIL=hello@atasteofaffy.com
